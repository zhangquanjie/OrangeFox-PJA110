<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!-- Use Android 17's early userspace instead of the OrangeFox 16 forks. -->
  <remove-project name="bionic" />
  <project path="bionic" name="platform/bionic" remote="aosp"
           revision="android-17.0.0_r1" />

  <remove-project name="system/core" />
  <project path="system/core" name="platform/system/core" remote="aosp"
           revision="android-17.0.0_r1" />

  <!-- Keep the OrangeFox application layer, using its current development
       branches with the latest ramdisk startup fixes. -->
  <remove-project name="bootable/Recovery" />
  <project path="bootable/recovery" name="bootable/Recovery"
           remote="OrangeFox" revision="fox_16.0-new" />

  <remove-project name="vendor/recovery" />
  <project path="vendor/recovery" name="vendor/recovery"
           remote="OrangeFox" revision="fox_16.0-new" />
</manifest>
